rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated, non-anonymous account owners may deposit failed
    // statement diagnostic bundles into their own write-once dropbox:
    //   users/{uid}/failed-statements/{sha256}/source.{pdf|csv|txt}
    //   users/{uid}/failed-statements/{sha256}/report.json
    //
    // Defense-in-depth guarantees:
    // - No client (including the uploading owner) can ever read, list, download,
    //   or overwrite any object in Storage. Inspection is restricted to IAM /
    //   Firebase Admin access.
    // - Anonymous sessions and cross-account paths are unconditionally denied.
    // - Filenames, SHA-256 folder IDs, MIME types, byte ceilings, and custom
    //   metadata keys/values are strictly validated on create.
    // - Owners may delete their own known reportId (e.g. from the error card or
    //   during account deletion) without gaining read or list access.

    function isSignedInOwner(uid) {
      return request.auth != null &&
        request.auth.uid == uid &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidReportId(reportId) {
      return reportId.matches('^[0-9a-f]{64}$');
    }

    function isValidFileName(fileName) {
      return fileName in ['source.pdf', 'source.csv', 'source.txt', 'report.json'];
    }

    function isValidPayload(fileName) {
      return request.resource != null &&
        request.resource.size > 0 &&
        (
          (fileName == 'source.pdf' &&
            request.resource.contentType == 'application/pdf' &&
            request.resource.size <= 25 * 1024 * 1024) ||
          (fileName == 'source.csv' &&
            request.resource.contentType in ['text/csv', 'application/csv', 'text/plain'] &&
            request.resource.size <= 5 * 1024 * 1024) ||
          (fileName == 'source.txt' &&
            request.resource.contentType == 'text/plain' &&
            request.resource.size <= 5 * 1024 * 1024) ||
          (fileName == 'report.json' &&
            request.resource.contentType == 'application/json' &&
            request.resource.size <= 256 * 1024)
        );
    }

    function isValidMetadata(reportId) {
      return request.resource.metadata != null &&
        request.resource.metadata.keys().hasAll([
          'errorCode',
          'reason',
          'appVersion',
          'sha256',
          'createdAt'
        ]) &&
        request.resource.metadata.keys().hasOnly([
          'errorCode',
          'reason',
          'appVersion',
          'sha256',
          'createdAt'
        ]) &&
        request.resource.metadata.sha256 == reportId &&
        request.resource.metadata.errorCode in [
          'unsupported_bank',
          'reconciliation',
          'unreadable',
          'other'
        ] &&
        request.resource.metadata.reason in [
          'unsupported_bank',
          'ambiguous_bank',
          'unreadable_text',
          'unreadable_pdf',
          'skipped_rows',
          'reconciliation_mismatch',
          'printed_totals_mismatch',
          'unverified_cover',
          'no_rows',
          'unexpected_parse_error'
        ] &&
        request.resource.metadata.appVersion.size() >= 1 &&
        request.resource.metadata.appVersion.size() <= 32 &&
        request.resource.metadata.appVersion.matches('^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$') &&
        request.resource.metadata.createdAt.size() >= 20 &&
        request.resource.metadata.createdAt.size() <= 32 &&
        request.resource.metadata.createdAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$');
    }

    match /users/{uid}/failed-statements/{reportId}/{fileName} {
      // Never expose uploaded diagnostic files to client reads, lists, or overwrites.
      allow read, update: if false;

      // Write-once create for verified owners with strict content & metadata checks.
      // Note: Firebase Storage evaluates object uploads as `create`, so `resource == null`
      // is required to block overwrites of existing objects.
      allow create: if resource == null &&
        isSignedInOwner(uid) &&
        isValidReportId(reportId) &&
        isValidFileName(fileName) &&
        isValidPayload(fileName) &&
        isValidMetadata(reportId);

      // Owners may delete their own known diagnostic report (e.g. account deletion).
      allow delete: if isSignedInOwner(uid) &&
        isValidReportId(reportId) &&
        isValidFileName(fileName);
    }

    // Deny every other bucket path unconditionally.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
