{
  "name": "mizan-frontend",
  "private": true,
  "version": "2.9.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "backend": "python ../backend/main.py",
    "verify": "vite-node scripts/verify-statement.ts --",
    "ios:configure": "node scripts/configure-ios-share.mjs",
    "ios:validate": "node scripts/validate-ios-share.mjs",
    "ios:sync": "cap sync ios && npm run ios:configure"
  },
  "dependencies": {
    "@capacitor-firebase/analytics": "^8.6.0",
    "@capacitor-firebase/app-check": "^8.6.0",
    "@capacitor-firebase/authentication": "^8.5.1",
    "@capacitor-firebase/crashlytics": "^8.6.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "lucide-react": "^0.395.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "recharts": "^2.12.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.4.38",
    "simple-plist": "1.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^2.1.8",
    "xcode": "3.0.1"
  }
}
