# Firebase web app config (public identifiers, not secrets — see
# https://firebase.google.com/docs/projects/api-keys). Copy this file to
# .env.local and fill in the values from the Firebase console, or run:
#   firebase apps:sdkconfig WEB <appId> --project <projectId>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (Web uses reCAPTCHA Enterprise site key; Android uses Play
# Integrity and iOS uses App Attest via @capacitor-firebase/app-check).
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# Development only: debug token registered in Firebase Console > App Check > Apps.
# Set to "true" to auto-generate and log a token in the browser console, or paste a UUID.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional emulator endpoints, used only by the Vite development server.
VITE_FIREBASE_AUTH_EMULATOR=
VITE_FIREBASE_FIRESTORE_EMULATOR=
VITE_FIREBASE_STORAGE_EMULATOR=

# Enable only after functions:reminders, Firestore rules and indexes have been
# deployed and verified. Device delivery acceptance is a separate user step.
# False keeps local reminders.
VITE_FCM_SCHEDULER_ENABLED=false
