# Firebase web app config (public identifiers, not secrets — see
# https://firebase.google.com/docs/projects/api-keys). Copy this file to
# .env.local and fill in the values from the Firebase console, or run:
#   firebase apps:sdkconfig WEB <appId> --project <projectId>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
