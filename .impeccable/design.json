  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The shared main record action.",
      "html": "<button class=\"ds-primary\">Kayıt ekle</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;border:0;border-radius:var(--radius);background:var(--accent);color:var(--text-inverse);font: 500 14px/1.5 'DM Sans Variable',system-ui,sans-serif;cursor:pointer;transition:background 160ms var(--ease),color 160ms var(--ease),transform 160ms var(--ease);}.ds-primary:hover{background:var(--accent-hover)}.ds-primary:active{transform:scale(.98)}.ds-primary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.ds-primary:disabled{opacity:.4;cursor:not-allowed}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A quieter action with a raised surface and line.",
      "html": "<button class=\"ds-secondary\">Ekstre ekle</button>",
      "css": ".ds-secondary{min-height:44px;padding:0 14px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg-raised);color:var(--text);font: 500 14px/1.5 'DM Sans Variable',system-ui,sans-serif;cursor:pointer;transition:background 160ms var(--ease),color 160ms var(--ease),transform 160ms var(--ease);}.ds-secondary:hover{background:var(--bg-hover)}.ds-secondary:active{transform:scale(.98)}.ds-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Ghost action",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "A low-priority reversible action.",
      "html": "<button class=\"ds-ghost\">Vazgeç</button>",
      "css": ".ds-ghost{min-height:44px;padding:0 16px;border:0;border-radius:var(--radius);background:transparent;color:var(--text-muted);font: 500 14px/1.5 'DM Sans Variable',system-ui,sans-serif;cursor:pointer;transition:background 160ms var(--ease),color 160ms var(--ease),transform 160ms var(--ease);}.ds-ghost:hover{background:var(--bg-hover);color:var(--text)}.ds-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Labelled amount field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible Turkish label and decimal amount guidance.",
      "html": "<label class=\"ds-field\"><span>Tutar (₺)</span><input inputmode=\"decimal\" placeholder=\"0,00\"><small>Örnek: 1.250,50</small></label>",
      "css": ".ds-field{display:grid;gap:8px;color:var(--text-muted);font:13px/1.5 'DM Sans Variable',system-ui,sans-serif}.ds-field input{height:44px;padding:0 12px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg-raised);color:var(--text);font:15px/1.5 'DM Sans Variable',system-ui,sans-serif;caret-color:var(--accent)}.ds-field input::placeholder{color:var(--text-faint)}.ds-field input:hover{border-color:var(--line-strong)}.ds-field input:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.ds-field small{font-size:12px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Workspace rail selection",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Ink rail and explicit active location.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Ana gezinme\"><button aria-current=\"page\">Özet<span></span></button><button>Harcamalar</button><button>Gelecek</button></nav>",
      "css": ".ds-nav{display:grid;gap:7px;background:var(--rail,#202335);padding:16px;border-radius:12px;font-family:'DM Sans Variable',system-ui,sans-serif}.ds-nav button{display:flex;align-items:center;min-height:45px;padding:0 13px;border:0;border-radius:9px;background:transparent;color:#c5c6dc;font:450 13px/1.5 'DM Sans Variable',system-ui,sans-serif;cursor:pointer}.ds-nav button:hover{background:#2c2f45;color:#fff}.ds-nav button[aria-current=page]{background:#39354f;color:#eee8ff;font-weight:550}.ds-nav button span{width:5px;height:5px;border-radius:50%;background:#b9aaff;margin-left:auto}.ds-nav button:focus-visible{outline:2px solid #b9aaff;outline-offset:4px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Sample label",
      "kind": "chip",
      "refersTo": "sample-chip",
      "description": "A clear tag for data that will not be stored.",
      "html": "<span class=\"ds-sample\">Örnek bütçe</span>",
      "css": ".ds-sample{display:inline-flex;padding:5px 9px;border-radius:6px;background:var(--onb-iris-soft,#eeebfb);color:var(--onb-iris,#6754c8);font:550 11px/1.5 'DM Sans Variable',system-ui,sans-serif}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Reading panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "A tonal reading surface with a clear heading.",
      "html": "<section class=\"ds-panel\"><h2>Harcama akışın</h2><p>İlk giderini eklediğinde akışın burada oluşur.</p></section>",
      "css": ".ds-panel{padding:22px 25px;border-radius:16px;background:var(--bg-raised);color:var(--text);font:13px/1.5 'DM Sans Variable',system-ui,sans-serif}.ds-panel h2{margin:0;font-size:14px;font-weight:550;letter-spacing:-.015em}.ds-panel p{margin:12px 0 0;color:var(--text-muted);line-height:1.8}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Budget allocation ribbon",
      "kind": "custom",
      "refersTo": "budget-ribbon",
      "description": "The no-limit state offers one clear setup action.",
      "html": "<section class=\"ds-budget\"><h2>Aylık harcama alanın</h2><p>Kendi dengeni kur.</p><span>Bir aylık limit belirle. Harcadıkça kalan alanını gör.</span><button>Limit belirle</button></section>",
      "css": ".ds-budget{padding:25px 26px;border-radius:16px;background:var(--iris-panel,#ece9fb);color:var(--iris-ink,#40337d);font:12px/1.7 'DM Sans Variable',system-ui,sans-serif}.ds-budget h2{font-size:14px;font-weight:550;margin:0}.ds-budget p{font-size:26px;font-weight:500;letter-spacing:-.025em;margin:30px 0 10px}.ds-budget>span{display:block;max-width:27ch}.ds-budget button{min-height:38px;padding:0 14px;margin-top:22px;border:1px solid rgb(113 97 216 / .4);border-radius:12px;color:inherit;background:transparent;font:600 12px/1.5 'DM Sans Variable',system-ui,sans-serif;cursor:pointer}.ds-budget button:hover{background:rgb(113 97 216 / .12)}.ds-budget button:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    }
  ],
  "narrative": {
    "northStar": "Ayın dengesi",
    "overview": "Mizan makes a person's recorded month readable through a composed workspace: a steady ink navigation rail, cool reading surfaces, and an iris budget area. The identity is precise and approachable. The folded M joins two sides of a balance; it remains a crisp vector rather than an illustration.\n\nThis is an Operate product. Familiar navigation, explicit financial labels, short entry flows, and visible account states carry the experience. The interactive introduction lets someone change a sample income, include rent, and move a spending limit before creating a real record. Its sample state never becomes financial history.",
    "keyCharacteristics": [
      "Ink navigation and iris selection give the shell a recognizable identity.",
      "Locally bundled DM Sans Variable supports Turkish text and tabular money.",
      "Tonal panels group work; spacing and rows keep detailed analysis legible.",
      "Budget allocation changes in response to records and sample controls.",
      "Light and dark themes, amount privacy, and reduced-motion preferences remain first-class states."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Extend the existing semantic roles and their dark counterparts; do not use a category color as the default text color of an unrelated control.",
        "section": "colors"
      },
      {
        "name": "The Number Rule",
        "body": "A displayed remainder means recorded income minus recorded net spending; its label must never imply a verified bank balance.",
        "section": "typography"
      },
      {
        "name": "The Reading Surface Rule",
        "body": "Use one surface boundary for a reading panel; save visible elevation for a layer or action that needs it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic colors, supplied brand assets, and the locally bundled typeface.",
      "Do give each financial number its real meaning and preserve amount privacy.",
      "Do label sample data and keep it outside saved records.",
      "Do retain keyboard focus, visible errors, safe areas, and reduced-motion behavior.",
      "Do keep account state and empty-state next actions understandable."
    ],
    "donts": [
      "Don't turn a recorded-income remainder into a bank balance claim.",
      "Don't animate stored values, reward spending, or add artificial streak pressure.",
      "Don't replace task hierarchy with decorative cards nested inside cards.",
      "Don't rename database keys, package identity, or cloud resources as part of a visual rebrand.",
      "Don't infer device delivery, authenticated cloud success, or publication from a local build."
    ]
  }
}
