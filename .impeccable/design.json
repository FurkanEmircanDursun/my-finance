      "css": ".ds-recovery{display:flex;align-items:center;flex-wrap:wrap;justify-content:space-between;gap:8px 16px;padding:12px 20px;background:var(--warning-soft,#fbf0dc);color:var(--warning,#7d4f10);font:15px/1.5 system-ui}.ds-recovery p{margin:0}.ds-recovery button{min-height:44px;border:1px solid var(--line,#dce3d9);border-radius:12px;background:var(--bg-raised,#fffefa);color:var(--text,#202925);padding:0 14px;cursor:pointer}.ds-recovery button:hover{background:var(--bg-hover,#e9ede5)}.ds-recovery button:focus-visible{outline:2px solid var(--accent,#155a4d)}"
