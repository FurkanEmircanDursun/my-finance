  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The shared main record action.",
      "html": "<button class=\"ds-primary\">İşlem ekle</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;border:0;border-radius:var(--radius);background:var(--accent);color:var(--text-inverse);font: 500 14px/1.5 'DM Sans Variable',system-ui,sans-serif;cursor:pointer;transition:background var(--motion-press,120ms) var(--ease-out-quick,ease-out),color var(--motion-press,120ms) var(--ease-out-quick,ease-out),transform var(--motion-press,120ms) var(--ease-out-quick,ease-out);}.ds-primary:hover{background:var(--accent-hover)}.ds-primary:active{transform:scale(.98)}.ds-primary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.ds-primary:disabled{opacity:.4;cursor:not-allowed}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A quieter action with a raised surface and line.",
      "html": "<button class=\"ds-secondary\">Ekstre yükle</button>",
      "css": ".ds-secondary{min-height:44px;padding:0 14px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg-raised);color:var(--text);font: 500 14px/1.5 'DM Sans Variable',system-ui,sans-serif;cursor:pointer;transition:background var(--motion-press,120ms) var(--ease-out-quick,ease-out),color var(--motion-press,120ms) var(--ease-out-quick,ease-out),transform var(--motion-press,120ms) var(--ease-out-quick,ease-out);}.ds-secondary:hover{background:var(--bg-hover)}.ds-secondary:active{transform:scale(.98)}.ds-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Ghost action",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "A low-priority reversible action.",
      "html": "<button class=\"ds-ghost\">Vazgeç</button>",
      "css": ".ds-ghost{min-height:44px;padding:0 16px;border:0;border-radius:var(--radius);background:transparent;color:var(--text-muted);font: 500 14px/1.5 'DM Sans Variable',system-ui,sans-serif;cursor:pointer;transition:background var(--motion-press,120ms) var(--ease-out-quick,ease-out),color var(--motion-press,120ms) var(--ease-out-quick,ease-out),transform var(--motion-press,120ms) var(--ease-out-quick,ease-out);}.ds-ghost:hover{background:var(--bg-hover);color:var(--text)}.ds-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Labelled amount field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible Turkish label and decimal amount guidance.",
      "html": "<label class=\"ds-field\"><span>Tutar (₺)</span><input inputmode=\"decimal\" placeholder=\"0,00\"><small>Örnek: 1.250,50</small></label>",
      "css": ".ds-field{display:grid;gap:8px;color:var(--text-muted);font:13px/1.5 'DM Sans Variable',system-ui,sans-serif}.ds-field input{height:44px;padding:0 12px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg-raised);color:var(--text);font:15px/1.5 'DM Sans Variable',system-ui,sans-serif;caret-color:var(--accent)}.ds-field input::placeholder{color:var(--text-faint)}.ds-field input:hover{border-color:var(--line-strong)}.ds-field input:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.ds-field small{font-size:12px}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}"
    },
    {
      "name": "Ana gezinme",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Ay Özeti, İşlemler, Kartlar ve Analiz.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Ana gezinme\"><a href=\"#/overview\" aria-current=\"page\">Ay Özeti</a><a href=\"#/transactions\">İşlemler</a><a href=\"#/cards\">Kartlar</a><a href=\"#/analysis\">Analiz</a></nav>",
      "css": ".ds-nav{display:grid;gap:4px;background:var(--bg-raised,#fffefa);padding:12px;font:550 15px/1.5 system-ui}.ds-nav a{display:flex;align-items:center;min-height:46px;padding:0 12px;border-radius:12px;text-decoration:none;color:var(--text-muted,#4c5c52)}.ds-nav a:hover{background:var(--bg-hover,#e9ede5)}.ds-nav a[aria-current]{background:var(--accent-soft,#e4eee8);color:var(--accent-text,#155244);font-weight:720}.ds-nav a:focus-visible{outline:2px solid var(--accent,#155a4d)}"
    },
